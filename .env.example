# JWT
JWT_SECRET=

# MAIL
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_SENDER=
APP_NAME=

# B
B_API_KEY=
B_API_SECRET=

# JIRA (bot task creation)
JIRA_BASE_URL=https://anyzhukatt.atlassian.net
JIRA_EMAIL=
# create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Test mode: the model runs for real, but nothing is created in Jira —
# the bot replies with what it would have filed. Leave unset on production.
# Status a freshly created task is moved into. The KAN board has no Agile
# backlog list, so "backlog" is a status. Empty = leave Jira's default.
JIRA_NEW_TASK_STATUS=Backlog
JIRA_DRY_RUN=
JIRA_PROJECT_KEY=KAN

# TELEGRAM
TELEGRAM_TOKEN=
ANTHROPIC_KEY=
TELEGRAM_OWNER_ID=
# polling — local dev; webhook — Vercel (default)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_AI_MODEL=claude-sonnet-5
# Ignore anything the bot said before this moment (ISO 8601). Set it to the
# deploy time whenever the persona changes, so the old voice cannot leak back
# into context through the bot's own history. Empty = keep the full history.
TELEGRAM_HISTORY_SINCE=
# Register webhook after deploy (polling and webhook are mutually exclusive — Telegram
# returns 409 to local polling while a webhook is set; deleteWebhook before local dev):
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<app>.vercel.app/telegram/webhook&secret_token=<SECRET>"
#   curl "https://api.telegram.org/bot<TOKEN>/deleteWebhook"

# MCP (POST /mcp — Kiro / Claude Code / Cursor talk to Claude through this API)
# Shared secret the IDE sends as `Authorization: Bearer <MCP_TOKEN>`.
# Unset = endpoint closed. Generate: openssl rand -hex 32
MCP_TOKEN=
# Default model behind ask_advice when a call does not pick one: opus|sonnet|fable
# (or a raw Anthropic model id). Effort: low|medium|high|xhigh|max
MCP_AI_MODEL=opus
MCP_AI_EFFORT=high
# Hard cap on /mcp calls per UTC day (shared Mongo counter). Guards against a
# leaked MCP_TOKEN running up the bill. Unset or 0 = no cap.
MCP_DAILY_LIMIT=200

# CORS: comma-separated allowed origins for the browser-facing API.
# Unset = open (allow any origin).
CORS_ORIGIN=

ENV=
# Project-manager mode of the Telegram bot (see CLAUDE.md)
TELEGRAM_PM_CHAT_IDS=
PM_DIGEST_CHAT_ID=
PM_RELEASE_DATE=
PM_PROJECT_BRIEF=
PM_AI_MODEL=
PM_AI_EFFORT=
PM_DIGEST_EFFORT=
PM_SNAPSHOT_MAX_AGE_HOURS=
PM_ATLASSIAN_BASE_URL=
PM_JIRA_PROJECTS=
# Jira fixVersion that is the release scope (metrics and forecast); unset = all open issues
PM_RELEASE_VERSION=
# Sprint custom field id, default customfield_10020
PM_JIRA_SPRINT_FIELD=
PM_CONFLUENCE_PAGE_IDS=
# Space keys the bot may search and read on demand (confluence_search / confluence_read_page); unset = off
PM_CONFLUENCE_SPACES=
# Page ids the bot must never read (titles about access/credentials are always refused)
PM_CONFLUENCE_EXCLUDE_PAGE_IDS=
# Knowledge docs up to this many characters go into every prompt; larger ones are indexed (default 60000)
PM_KNOWLEDGE_INLINE_CHARS=
PM_GITHUB_TOKEN=
PM_GITHUB_ORG=
PM_GITHUB_REPOS=
PM_GITHUB_COMPARES=
PM_FIGMA_TOKEN=
PM_FIGMA_FILE_KEYS=
CRON_SECRET=
PM_CODE_REPOS=
PM_ACTION_USER_IDS=
PM_DM_USERNAMES=
PM_TEAM=
STAGING_API_BASE_URL=
STAGING_ALLOWED_HOSTS=
STAGING_FORBIDDEN_HOSTS=
STAGING_ADMIN_EMAIL=
STAGING_ADMIN_PASSWORD=
DEV_API_BASE_URL=
DEV_ALLOWED_HOSTS=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_CLIENT_EMAIL=
DEV_CLIENT_PASSWORD=
DEV_PLATFORM_ADMIN_EMAIL=
DEV_PLATFORM_ADMIN_PASSWORD=
STAGING_CLIENT_EMAIL=
STAGING_CLIENT_PASSWORD=
STAGING_PLATFORM_ADMIN_EMAIL=
STAGING_PLATFORM_ADMIN_PASSWORD=
