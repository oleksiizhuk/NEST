{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/cron/pm/daily",
      "schedule": "0 5 * * 1-5"
    },
    {
      "path": "/cron/pm/refresh",
      "schedule": "0 5 * * 0,6"
    },
    {
      "path": "/cron/pm/watch?slot=1",
      "schedule": "0 8 * * 1-5"
    },
    {
      "path": "/cron/pm/watch?slot=2",
      "schedule": "0 11 * * 1-5"
    },
    {
      "path": "/cron/pm/watch?slot=3",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/cron/pm/eval?slot=1",
      "schedule": "0 2 * * 1"
    },
    {
      "path": "/cron/pm/eval?slot=2",
      "schedule": "20 2 * * 1"
    },
    {
      "path": "/cron/pm/eval?slot=3",
      "schedule": "40 2 * * 1"
    }
  ]
}
