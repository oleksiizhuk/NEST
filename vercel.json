{
  "buildCommand": "npm run build && npm run build:admin",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/cron/pm/daily",
      "schedule": "0 5 * * 1-5"
    },
    {
      "path": "/cron/pm/refresh",
      "schedule": "0 5 * * 0,6"
    },
    {
      "path": "/cron/pm/watch?slot=1",
      "schedule": "0 8 * * 1-5"
    },
    {
      "path": "/cron/pm/watch?slot=2",
      "schedule": "0 11 * * 1-5"
    },
    {
      "path": "/cron/pm/watch?slot=3",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/cron/pm/eval?slot=1",
      "schedule": "0 2 * * 1"
    },
    {
      "path": "/cron/pm/eval?slot=2",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/cron/pm/eval?slot=3",
      "schedule": "0 4 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
